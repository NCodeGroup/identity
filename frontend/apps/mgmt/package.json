{
  "name": "@ncodegroup/identity-app-mgmt",
  "version": "0.0.0",
  "private": true,
  "description": "NCode.Identity Management console (served by its BFF host).",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@ncodegroup/identity-api": "workspace:*",
    "@ncodegroup/identity-brand": "workspace:*",
    "@ncodegroup/identity-config": "workspace:*",
    "@ncodegroup/identity-shell": "workspace:*",
    "@ncodegroup/identity-store": "workspace:*",
    "@ncodegroup/identity-ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.1.2"
  },
  "devDependencies": {
    "@ncodegroup/identity-test-support": "workspace:*",
    "@ncodegroup/identity-vite-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
