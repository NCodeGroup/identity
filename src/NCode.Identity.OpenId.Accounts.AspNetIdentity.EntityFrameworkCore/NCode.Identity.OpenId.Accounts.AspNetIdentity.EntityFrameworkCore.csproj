<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>NCode.Identity.OpenId.Accounts.AspNetIdentity.EntityFrameworkCore</RootNamespace>
        <Description>Entity Framework Core model configuration for the ASP.NET Core Identity local-account store of NCode.Identity: the lengths of the columns its tenant-prefixed lookups need.</Description>
    </PropertyGroup>

    <ItemGroup>
        <!-- Microsoft.Extensions.Identity.Stores (IdentityUser) ships in the ASP.NET Core shared framework. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NCode.Identity.OpenId.Accounts.Abstractions\NCode.Identity.OpenId.Accounts.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
    </ItemGroup>
</Project>
