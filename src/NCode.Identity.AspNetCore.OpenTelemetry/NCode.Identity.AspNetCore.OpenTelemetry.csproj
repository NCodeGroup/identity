<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>NCode.Identity.AspNetCore.OpenTelemetry</RootNamespace>
        <Description>The opt-in OpenTelemetry metrics registration of NCode.Identity for an ASP.NET Core host: the family's meters and the platform's built-in meters with bounded attributes, exported over OTLP when an endpoint is configured.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    </ItemGroup>
</Project>
