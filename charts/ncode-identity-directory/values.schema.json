{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ncode-identity-directory values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "awsWebIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roleArn": {
          "type": "string"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "tokenExpirationSeconds": {
          "type": "integer",
          "minimum": 600
        }
      }
    },
    "azureWorkloadIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantId": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "tokenExpirationSeconds": {
          "type": "integer",
          "minimum": 600
        }
      }
    },
    "googleWorkloadIdentityFederation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "serviceAccountEmail": {
          "type": "string"
        },
        "tokenExpirationSeconds": {
          "type": "integer",
          "minimum": 600
        }
      }
    },
    "remoteKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "keyId",
        "algorithm",
        "secretType",
        "keySizeBits"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "aws-kms",
            "azure-key-vault",
            "google-cloud-kms"
          ]
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "secretType": {
          "type": "string",
          "minLength": 1
        },
        "keySizeBits": {
          "type": "integer",
          "minimum": 1
        },
        "curve": {
          "type": "string"
        }
      }
    },
    "keyRing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pemSecret": {
          "type": "string"
        },
        "remoteKeys": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9]+([._-][A-Za-z0-9]+)*$",
            "maxLength": 64
          },
          "additionalProperties": {
            "$ref": "#/definitions/remoteKey"
          }
        }
      }
    }
  },
  "required": [
    "issuer",
    "keyRing",
    "keys",
    "tokenLifetime",
    "controlPlane",
    "allowedHosts",
    "database",
    "migrations"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "keyRing": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]+([._-][A-Za-z0-9]+)*$"
    },
    "keys": {
      "allOf": [
        {
          "$ref": "#/definitions/keyRing"
        },
        {
          "anyOf": [
            {
              "required": [
                "pemSecret"
              ],
              "properties": {
                "pemSecret": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "required": [
                "remoteKeys"
              ],
              "properties": {
                "remoteKeys": {
                  "type": "object",
                  "minProperties": 1
                }
              }
            }
          ]
        }
      ]
    },
    "tokenLifetime": {
      "type": "string",
      "minLength": 1
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell",
        "region",
        "kind",
        "tenantId",
        "issuer",
        "clientJwks"
      ],
      "properties": {
        "cell": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31,
          "pattern": "^[a-z](-?[a-z0-9])*$"
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31,
          "pattern": "^[a-z](-?[a-z0-9])*$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "issuer": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "clientJwks": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "allowedHosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "const": "*"
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location": {
          "type": "string"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "otlpEndpoint": {
          "type": "string",
          "anyOf": [
            {
              "maxLength": 0
            },
            {
              "format": "uri"
            }
          ]
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtimeRole": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string"
        },
        "connectionStringKey": {
          "type": "string",
          "minLength": 1
        },
        "parts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "hostKey": {
              "type": "string"
            },
            "portKey": {
              "type": "string"
            },
            "databaseKey": {
              "type": "string"
            },
            "usernameKey": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "runtimeRole"
      ],
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "existingSecret"
              ],
              "properties": {
                "existingSecret": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "required": [
                "parts"
              ],
              "properties": {
                "parts": {
                  "type": "object",
                  "required": [
                    "existingSecret"
                  ],
                  "properties": {
                    "existingSecret": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "connectionStringKey": {
              "type": "string"
            },
            "parts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingSecret": {
                  "type": "string"
                },
                "hostKey": {
                  "type": "string"
                },
                "portKey": {
                  "type": "string"
                },
                "databaseKey": {
                  "type": "string"
                },
                "usernameKey": {
                  "type": "string"
                },
                "passwordKey": {
                  "type": "string"
                }
              }
            }
          },
          "allOf": [
            {
              "anyOf": [
                {
                  "required": [
                    "existingSecret"
                  ],
                  "properties": {
                    "existingSecret": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "required": [
                    "parts"
                  ],
                  "properties": {
                    "parts": {
                      "type": "object",
                      "required": [
                        "existingSecret"
                      ],
                      "properties": {
                        "existingSecret": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        }
      },
      "required": [
        "database"
      ]
    },
    "aws": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "webIdentity": {
          "$ref": "#/definitions/awsWebIdentity"
        }
      }
    },
    "azure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workloadIdentity": {
          "$ref": "#/definitions/azureWorkloadIdentity"
        }
      }
    },
    "google": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workloadIdentityFederation": {
          "$ref": "#/definitions/googleWorkloadIdentityFederation"
        }
      }
    },
    "backendTls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "ingressSecret": {
          "type": "string"
        },
        "caConfigMap": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "group": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "namespace": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "sectionName": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Creates the directory's ServiceAccount."
        },
        "name": {
          "type": "string",
          "description": "The directory's ServiceAccount; empty uses the directory's full name when create is true and 'default' otherwise."
        },
        "annotations": {
          "type": "object",
          "description": "Annotations for the directory's ServiceAccount."
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "global": {
      "type": "object"
    }
  }
}
